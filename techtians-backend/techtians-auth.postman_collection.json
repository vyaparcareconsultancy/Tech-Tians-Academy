{
  "info": {
    "name": "Tech Tians - Auth API Collection",
    "description": "Full end-to-end authentication flow for Tech Tians platform: Register -> Send OTP -> Verify OTP -> Login -> Get Me -> Refresh Token -> Logout",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Response indicates success', () => pm.expect(json.success).to.be.true);",
              "if (json.data && json.data.tokens) {",
              "  pm.environment.set('accessToken', json.data.tokens.accessToken);",
              "  pm.environment.set('refreshToken', json.data.tokens.refreshToken);",
              "  pm.environment.set('userId', json.data.user.id);",
              "  pm.environment.set('userEmail', json.data.user.email);",
              "  pm.environment.set('userPassword', 'Password123');",
              "}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const timestamp = Date.now();",
              "const randomDigits = Math.floor(10000000 + Math.random() * 90000000);",
              "pm.environment.set('genEmail', `student_${timestamp}@example.com`);",
              "pm.environment.set('genPhone', `+9198${randomDigits}`);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student Test User\",\n  \"email\": \"{{genEmail}}\",\n  \"phone\": \"{{genPhone}}\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Send OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('OTP dispatch message received', () => pm.expect(json.data.cooldownSeconds).to.be.a('number'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{userEmail}}\",\n  \"purpose\": \"SIGNUP\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/otp/send",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "otp", "send"]
        }
      }
    },
    {
      "name": "3. Verify OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status code is 200 or 400 (if dev otp mismatched)', () => pm.expect([200, 400]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{userEmail}}\",\n  \"otp\": \"123456\",\n  \"purpose\": \"SIGNUP\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "otp", "verify"]
        }
      }
    },
    {
      "name": "4. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Tokens returned in data payload', () => {",
              "  pm.expect(json.data.tokens.accessToken).to.be.a('string');",
              "  pm.expect(json.data.tokens.refreshToken).to.be.a('string');",
              "});",
              "pm.environment.set('accessToken', json.data.tokens.accessToken);",
              "pm.environment.set('refreshToken', json.data.tokens.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "5. Get Profile (Me)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Profile data returned', () => {",
              "  pm.expect(json.data.email).to.equal(pm.environment.get('userEmail'));",
              "  pm.expect(json.data.roles).to.include('STUDENT');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      }
    },
    {
      "name": "6. Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Fresh token pair issued', () => {",
              "  pm.expect(json.data.accessToken).to.be.a('string');",
              "  pm.expect(json.data.refreshToken).to.be.a('string');",
              "});",
              "pm.environment.set('accessToken', json.data.accessToken);",
              "pm.environment.set('refreshToken', json.data.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "refresh"]
        }
      }
    },
    {
      "name": "7. Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Logout confirmed', () => pm.expect(json.data.message).to.contain('Logged out'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "logout"]
        }
      }
    }
  ]
}

# ==============================================================================
# Tech Tians Backend - Environment Variables
# ==============================================================================

# Application Environment: 'development' | 'production' | 'test' | 'provision'
NODE_ENV=development

# Application Port (HTTP Server)
PORT=5000

# Comma-separated list of frontends allowed to call this API (student app, admin panel)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==============================================================================
# Database Configuration (PostgreSQL 16)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=techtians_db
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techtians_db?schema=public

# ==============================================================================
# Cache / Queue Configuration (Redis 7)
# ==============================================================================
# Format: redis://[user]:[password]@[host]:[port]
REDIS_URL=redis://localhost:6379

# ==============================================================================
# JWT Authentication Configuration
# ==============================================================================
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_123456
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_123456
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ==============================================================================
# Initial Seed Configuration
# ==============================================================================
ADMIN_EMAIL=admin@techtians.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=System Administrator
